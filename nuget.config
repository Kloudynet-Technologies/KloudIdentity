<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="kloudynet" value="https://nuget.pkg.github.com/Kloudynet-Technologies/index.json" />
  </packageSources>
  <!--
    Restrict NuGet's security audit to nuget.org. GitHub Packages does not serve a package
    vulnerability database, so auditing the 'kloudynet' feed only produces a spurious NU1900
    warning. Vulnerability scanning still runs against nuget.org packages.
  -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- KN.KI.LogAggregator.* are published publicly on nuget.org, not on the private
           GitHub Packages feed. This longer prefix wins over kloudynet's "KN.KI.*" mapping,
           so these resolve from nuget.org while the private packages below stay on kloudynet. -->
      <package pattern="KN.KI.LogAggregator.*" />
    </packageSource>
    <packageSource key="kloudynet">
      <package pattern="KN.KI.*" />
      <!-- Exception: SerilogInitializer moved to the private feed from 1.0.5 (1.0.0–1.0.4 are on
           nuget.org). An exact package ID wins over the KN.KI.LogAggregator.* prefix above. -->
      <package pattern="KN.KI.LogAggregator.SerilogInitializer" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <kloudynet>
      <add key="Username" value="%KLOUDYNET_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%KLOUDYNET_NUGET_PASSWORD%" />
    </kloudynet>
  </packageSourceCredentials>
</configuration>
